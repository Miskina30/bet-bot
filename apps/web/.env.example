# ============================================================================
# Academic Edge web - example environment (12-factor). Copy to `.env.local`.
#
# NEVER commit a real .env / .env.local (see the repo .gitignore and the
# `no-secrets` CI job). Nothing here is a bookmaker credential: this app is
# READ-ONLY and stores no wagering credentials of any kind.
#
# README (web app): see apps/web/README.md
# ============================================================================

# ---- Browser-visible configuration -----------------------------------------
# Base URL of the FastAPI backend. Must be reachable FROM THE BROWSER.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional low-privilege READER key (`reader` role) for GET requests made
# directly from the browser. Leave empty in the local no-auth profile.
# The value is public by definition - never put an analyst/admin key here.
NEXT_PUBLIC_API_READ_KEY=

# Optional SSE stale window (ms). The hook marks the stream "stale" when no
# opportunity event has arrived for this long. Default 30000.
NEXT_PUBLIC_SSE_STALE_AFTER_MS=30000

# ---- Server-only configuration (Next.js Route Handlers) --------------------
# Used by the two write-capable proxies (alert acknowledgement, resolver
# decision). They run on the server so the analyst key never reaches the
# browser. Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
ACADEMIC_EDGE_API_BASE_URL=http://localhost:8000

# Analyst-role key, server side only. Leave empty to keep analyst actions off.
ACADEMIC_EDGE_ANALYST_API_KEY=

# Safety gate for the analyst-only actions ("acknowledge alert", "manual link").
# Anything other than the literal string `enabled` disables the buttons AND the
# route handlers, so a deployment cannot accidentally expose them.
ACADEMIC_EDGE_ANALYST_ACTIONS=disabled

# ---- Playwright (E2E) ------------------------------------------------------
# Base URL Playwright drives. The suite expects the API + web app to be running.
PLAYWRIGHT_BASE_URL=http://localhost:3000