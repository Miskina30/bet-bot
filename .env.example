# ============================================================================
# Academic Edge - example configuration (12-factor). Copy to `.env`.
# NEVER commit a real `.env`. The local demo profile needs NO keys at all.
# ============================================================================

# ---------- Runtime profile ----------
ACADEMIC_EDGE_ENV=local            # local | test | staging | production
LOG_LEVEL=INFO
# Local profile uses SQLite so `docker compose up` is optional for development.
# Production profile (docker-compose) overrides this with Postgres 16.
DATABASE_URL=sqlite+pysqlite:///./.data/academic_edge.db
# DATABASE_URL=postgresql+psycopg://academic_edge:academic_edge@localhost:5432/academic_edge
REDIS_URL=redis://localhost:6379/0

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated role keys. Empty => dev mode: single implicit "admin" role,
# responses carry X-Academic-Edge-Dev-Auth: true so it is never mistaken for prod.
API_KEYS=
# API_KEYS=analyst-key:analyst,admin-key:admin,reader-key:reader

# ---------- Raw immutable archive (append-only) ----------
# filesystem (default, zero-dependency) | s3
RAW_ARCHIVE_BACKEND=filesystem
RAW_ARCHIVE_DIR=./.data/raw-archive
# S3 uses the standard AWS_* variables below when RAW_ARCHIVE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=academic-edge-raw
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# ---------- Provider: API-Football (api-sports.io) ----------
# Free tier: https://dashboard.api-football.com/register  (100 req/day)
# Leave the key empty to fall back to labelled frozen fixtures.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_DAILY_QUOTA=100

# ---------- Provider: football-data.org (v4) ----------
# Free tier: https://www.football-data.org/client/register (10 req/min, 12 comps)
FOOTBALL_DATA_ORG_TOKEN=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_ORG_RATE_LIMIT_PER_MIN=10

# ---------- Provider: Polymarket (public read, keyless) ----------
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_ENABLED=true

# ---------- Provider: Football-Data.co.uk (historical CSV, public) ----------
FOOTBALL_DATA_UK_BASE_URL=https://www.football-data.co.uk
FOOTBALL_DATA_UK_ENABLED=true

# ---------- Provider: Crocobet (MANUAL CSV ONLY in MVP) ----------
# Web automation stays hard-disabled until permission/terms review is recorded
# in config/source_policies.yaml (terms_reviewed_by + terms_reviewed_at).
CROCOBET_WEB_ENABLED=false
CROCOBET_CSV_DIR=./.data/crocobet-inbox
CROCOBET_TERMS_REVIEW_ID=

# ---------- Resolver ----------
RESOLVER_AUTO_ACCEPT_THRESHOLD=0.985
RESOLVER_REVIEW_THRESHOLD=0.940
RESOLVER_TIME_WINDOW_MINUTES=180

# ---------- Pricing / alerting frictions (all conservative by default) ----------
PRICING_MAX_QUOTE_AGE_SECONDS=180
PRICING_SLIPPAGE_BPS=15
PRICING_EXCHANGE_FEE_BPS=200
PRICING_FX_SPREAD_BPS=25
PRICING_MIN_NET_EDGE_BPS=50
PRICING_QUOTE_AGE_HAIRCUT_BPS_PER_MIN=20
PRICING_MAX_QUOTE_AGE_HAIRCUT_BPS=200
PRICING_BANKROLL=1000
PRICING_MIN_STAKE=1

# ---------- ML / forecasting ----------
MODEL_TIME_DECAY_HALF_LIFE_DAYS=180
WALK_FORWARD_MIN_TRAIN_EVENTS=200
MLFLOW_TRACKING_URI=